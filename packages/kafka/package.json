    "@polaris/shared-types": "workspace:*",
    "@polaris/shared-utils": "workspace:*",
    "dotenv": "17.4.2",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@polaris/build-config": "workspace:*",
    "@polaris/tsconfig": "workspace:*",
    "rolldown": "1.1.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
