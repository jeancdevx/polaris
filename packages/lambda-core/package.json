{
  "name": "@polaris/lambda-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.33.1",
    "@aws-lambda-powertools/metrics": "2.33.1",
    "@aws-lambda-powertools/tracer": "2.33.1",
    "@middy/core": "7.7.0"
  },
  "devDependencies": {
    "@polaris/build-config": "workspace:*",
    "@polaris/tsconfig": "workspace:*",
    "@types/aws-lambda": "8.10.161",
    "rolldown": "1.1.2",
    "typescript": "6.0.3"
  }
}
