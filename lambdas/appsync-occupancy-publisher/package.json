    "@smithy/signature-v4": "5.5.2",
    "@smithy/types": "4.12.0"
  },
  "devDependencies": {
    "@polaris/build-config": "workspace:*",
    "@polaris/tsconfig": "workspace:*",
    "@types/aws-lambda": "8.10.161",
    "rolldown": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
