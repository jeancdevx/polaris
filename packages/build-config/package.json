{
  "name": "@polaris/build-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@polaris/tsconfig": "workspace:*",
    "rolldown": "1.1.2",
    "typescript": "6.0.3"
  }
}
