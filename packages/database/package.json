{
  "name": "@polaris/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "migration:run": "tsx src/cli/migrate-run.ts",
    "migration:revert": "tsx src/cli/migrate-revert.ts",
    "migration:show": "tsx src/cli/migrate-show.ts",
    "seed": "tsx src/cli/seed.ts",
    "seed:redis": "tsx src/cli/sync-redis.ts",
    "reset:dev": "tsx src/cli/reset-dev.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1075.0",
    "@aws-sdk/client-secrets-manager": "^3.1087.0",
    "@polaris/domain": "workspace:*",
    "@polaris/shared-types": "workspace:*",
    "@polaris/shared-utils": "workspace:*",
    "pg": "8.22.0",
    "redis": "6.0.0",
    "typeorm": "1.0.0"
  },
  "devDependencies": {
    "@polaris/tsconfig": "workspace:*",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.9",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
