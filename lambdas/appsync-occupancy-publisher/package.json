{
  "name": "@polaris/appsync-occupancy-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && printf '%s\\n' '{\"name\":\"@polaris/appsync-occupancy-publisher\",\"type\":\"module\"}' > dist/package.json",
