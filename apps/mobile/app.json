{
  "expo": {
    "name": "Polaris",
    "slug": "polaris-mobile",
    "version": "0.1.0",
    "scheme": "polaris",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070b10",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b10",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
