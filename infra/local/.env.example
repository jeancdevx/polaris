DATABASE_URL=postgresql://parking_admin:parking_dev@localhost:5432/parking_db
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
AWS_REGION=us-east-2
PORT=3001

# reservation-service local — omitir Kafka si el broker no corre
KAFKA_PUBLISH_ENABLED=false

# event-processor local — sin EventBridge/AWS (handlers de reserva no-op aquí)
# EVENTBRIDGE_ENABLED=false

# Cognito (dev) — outputs de `terraform output` en iac/environments/dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER_URL=

# admin-service (Fase 6.1)
# RFID_VALIDATIONS_TABLE_NAME=polaris-dev-RFIDValidations
