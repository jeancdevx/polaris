# Modo AWS (pnpm mobile:env:dev) — una sola URL para auth, availability y reservas:
EXPO_PUBLIC_API_URL=https://example.execute-api.us-east-2.amazonaws.com
EXPO_PUBLIC_APPSYNC_GRAPHQL_ENDPOINT=https://example.appsync-api.us-east-2.amazonaws.com/graphql
EXPO_PUBLIC_APPSYNC_REALTIME_ENDPOINT=wss://example.appsync-realtime-api.us-east-2.amazonaws.com/graphql
EXPO_PUBLIC_AWS_REGION=us-east-2

# Modo local (pnpm mobile:env:local) — auth/availability :3001, reservas :3002:
# EXPO_PUBLIC_API_URL=http://localhost:3001
# EXPO_PUBLIC_RESERVATION_API_URL=http://localhost:3002
# (localhost se reescribe automáticamente a la IP del bundler en dispositivo físico)
