# Bootstrap Terraform State Configuration
# Copy this file to terraform.tfvars and update the values accordingly.
# This file is used to bootstrap the S3 bucket for Terraform state storage.

aws_region  = "us-east-2"
aws_profile = "your-sso-profile"

project_name = "polaris"
environment  = "bootstrap"

# Optional: set only if you need a specific pre-defined bucket name
# Must be globally unique across all AWS accounts
# state_bucket_name_override = "your-unique-tfstate-bucket-name"

# State bucket configuration
enable_versioning         = true
enable_lifecycle_rules    = true
lifecycle_noncurrent_days = 90

# Additional tags for all resources
tags = {
  ManagedBy = "terraform"
  Project   = "polaris"
  Owner     = "devops"
}
